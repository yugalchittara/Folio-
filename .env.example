# Server-side only. Never prefix partner secrets with NEXT_PUBLIC_.
# Tidepool is the NEAR Intents / 1Click-compatible testnet sandbox.
ONECLICK_BASE_URL=https://www.usetidepool.tech
ONECLICK_JWT=
# Public merchant receiving address on Base Sepolia. This remains server-side so buyers cannot change the settlement recipient.
TIDEPOOL_MERCHANT_BASE_SEPOLIA_ADDRESS=
# Wallet risk / sanctions gate. `demo` is local-only and not a real KYT result.
# Swap this for a server-side TRM, Chainalysis, or Elliptic adapter before launch.
COMPLIANCE_PROVIDER=demo
# Used only by the POS QR. Set this to a LAN or tunnel URL so a customer's phone
# can open the locally running buyer checkout, e.g. http://192.168.x.x:3000.
NEXT_PUBLIC_CHECKOUT_ORIGIN=
# Optional RPC overrides for read-only USDC balances in Operations.
# Public testnet RPC endpoints are used when these are empty.
BASE_SEPOLIA_RPC_URL=
ARBITRUM_SEPOLIA_RPC_URL=
# Circle CPN / payout adapter. Confirm the current sandbox base URL and credentials
# with Circle onboarding before populating these fields.
CIRCLE_CPN_API_BASE_URL=
CIRCLE_CPN_API_KEY=
CIRCLE_CPN_ENTITY_ID=

# Application infrastructure (next build phase)
DATABASE_URL=
WEBHOOK_SIGNING_SECRET=
